{
  "name": "hsl-local-app",
  "version": "0.3.0",
  "private": true,
  "description": "High Score League local event reader",
  "main": "gui/main.js",
  "scripts": {
    "start": "node app.js scan",
    "scan": "node app.js scan",
    "watch": "node app.js watch",
    "sent": "node app.js mark-sent",
    "failed": "node app.js mark-failed",
    "restore": "node app.js restore",
    "login": "node app.js login",
    "auth-status": "node app.js auth-status",
    "logout": "node app.js logout",
    "diagnose": "node app.js diagnose",
    "sync-plugin": "node app.js sync-plugin",
    "gui": "electron .",
    "play": "node app.js play",
    "practice": "node app.js practice",
    "submit": "node app.js submit",
    "submit-all": "node app.js submit-all",
    "prepare:mame": "node scripts/prepare-mame.js",
    "prepare:plugin": "node scripts/stage-product-plugin.js",
    "prepare:package": "node scripts/prepare-package.js",
    "package:win": "npm run prepare:package && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist:win": "npm run prepare:package && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never && npm run validate:update-artifacts",
    "validate:update-artifacts": "node scripts/validate-update-artifacts.js",
    "prepare:release-bundle": "node scripts/prepare-windows-release-bundle.js",
    "validate:release-bundle": "node scripts/validate-windows-release-bundle.js",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "electron-updater": "6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "yazl": "^3.3.1"
  }
}
